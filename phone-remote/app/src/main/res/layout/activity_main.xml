<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- 顶部：连接状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_demo"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/lastAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 电源键：按住方式发送，短按弹出关机菜单，长按直接关机（由投影仪判断） -->
        <TextView
            android:id="@+id/keyPower"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_key_power"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:hapticFeedbackEnabled="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="电源"
            android:textColor="@color/power"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_key"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/connect"
            android:textColor="@color/accent"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 页面切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabKeys"
            style="@style/Tab"
            android:text="@string/tab_keys" />

        <TextView
            android:id="@+id/tabTouchpad"
            style="@style/Tab"
            android:text="@string/tab_touchpad" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <!-- 按键页：从上到下为 设置/主页、投影功能、音量、返回/菜单、方向键。
             方向键放在最下面，方便单手握持时用拇指操作；它会占满剩余高度（有最大尺寸限制）。 -->
        <LinearLayout
            android:id="@+id/pageKeys"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/keySettings"
                    style="@style/Key"
                    android:text="设置" />

                <TextView
                    android:id="@+id/keyHome"
                    style="@style/Key"
                    android:text="主页" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:text="@string/section_projector"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:useDefaultMargins="false">

                <TextView
                    android:id="@+id/fnDeepFocus"
                    style="@style/FunctionKey"
                    android:text="深度对焦" />

                <TextView
                    android:id="@+id/fnSmart"
                    style="@style/FunctionKey"
                    android:text="自动梯形" />

                <TextView
                    android:id="@+id/fnKeystone"
                    style="@style/FunctionKey"
                    android:text="手动梯形" />

                <TextView
                    android:id="@+id/fnSize"
                    style="@style/FunctionKey"
                    android:text="画面尺寸" />

                <TextView
                    android:id="@+id/fnDisplace"
                    style="@style/FunctionKey"
                    android:text="画面位移" />

                <TextView
                    android:id="@+id/fnGame"
                    style="@style/FunctionKey"
                    android:text="游戏模式" />

                <TextView
                    android:id="@+id/fnMemc"
                    style="@style/FunctionKey"
                    android:text="MEMC" />

                <TextView
                    android:id="@+id/fnBrightness"
                    style="@style/FunctionKey"
                    android:text="亮度" />
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/keyVolDown"
                    style="@style/Key"
                    android:text="音量 −" />

                <TextView
                    android:id="@+id/keyMute"
                    style="@style/Key"
                    android:text="静音" />

                <TextView
                    android:id="@+id/keyVolUp"
                    style="@style/Key"
                    android:text="音量 +" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/keyBack"
                    style="@style/Key"
                    android:text="返回" />

                <TextView
                    android:id="@+id/keyMenu"
                    style="@style/Key"
                    android:text="菜单" />
            </LinearLayout>

            <dev.imeiyou.projectorremote.DpadView
                android:id="@+id/dpad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:minHeight="180dp" />
        </LinearLayout>

        <!-- 触控板页 -->
        <LinearLayout
            android:id="@+id/pageTouchpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <dev.imeiyou.projectorremote.TouchpadView
                android:id="@+id/touchpad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="5dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpBack"
                    style="@style/Key"
                    android:text="返回" />

                <TextView
                    android:id="@+id/tpHome"
                    style="@style/Key"
                    android:text="主页" />

                <TextView
                    android:id="@+id/tpOk"
                    style="@style/Key"
                    android:text="确认" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
